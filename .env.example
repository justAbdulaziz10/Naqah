# Exact build-time opt-in for both browser account mode and the server account gate. All other values disable it.
# Only after migrations 0001-0005 and authorized real-owner validation. Disabled: /api/account returns 404;
# owner Server Actions return unavailable before any session/repository access. No separate server flag.
# Rollback requires a new build/deployment; it preserves saved data and does not stop voice or direct Supabase access.
NEXT_PUBLIC_NAQAH_ACCOUNT_DATA=
# Unset or "sample": calls run the sample farm and save nothing. "farm": calls resolve to a real farm in
# Supabase, and need TWILIO_AUTH_TOKEN, NAQAH_PUBLIC_BASE_URL and SUPABASE_SECRET_KEY. See docs/integrations/twilio-activation.md.
NAQAH_VOICE_MODE=
# Farm mode only. Set to 1 to let the owner's number hear farm data. Caller ID can be spoofed, so this is off by default.
NAQAH_VOICE_OWNER_INQUIRY=
# Server-side HMAC key: signs the sample line's Gather state and, in farm mode, the farm/run token on report-call URLs.
# Use a random value of at least 32 bytes.
NAQAH_VOICE_SECRET=
# Registered worker caller ID in E.164 format, for example +9665XXXXXXXX.
NAQAH_WORKER_PHONE=
# Registered owner caller ID in E.164 format. Owner inquiry calls are only matched when set.
NAQAH_OWNER_PHONE=
# Public HTTPS origin Twilio uses for webhook signatures when proxy headers do not preserve it.
NAQAH_PUBLIC_BASE_URL=
# Set to 1 only to allow unsigned voice calls in production; paid summaries stay disabled without verified signatures.
NAQAH_ALLOW_UNSIGNED_VOICE=
# ar by default; set to en to run the voice flow in English.
NAQAH_VOICE_LOCALE=
# Optional Polly voice overrides. Defaults: Polly.Zeina (Arabic) and Polly.Joanna (English).
NAQAH_VOICE_ARABIC_VOICE=
NAQAH_VOICE_ENGLISH_VOICE=
# Required for webhook signature checks. Production voice is disabled without it unless unsigned voice is explicitly allowed.
TWILIO_AUTH_TOKEN=
# Outbound calls: farm-mode report calls to the worker, and owner update calls. Caller ID in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
# Set to 1 to place a paid outbound Twilio call with the saved report summary (farm mode: to the farm's owner_phone).
NAQAH_CALL_OWNER=
# Bearer secret for GET /api/cron/report-calls (run every ~5 min). Unset: the scheduler refuses every request.
CRON_SECRET=
# 1 = the cron route may dial scheduled report calls. Off by default, even with CRON_SECRET set.
NAQAH_SCHEDULED_CALLS=
# 1 = the owner's "Call now" on the dashboard (one controlled report call to the farm's saved primary worker).
NAQAH_MANUAL_REPORT_CALLS=
# Comma-separated E.164 numbers NAQAH may dial (controlled tests). Unset = no extra limit; invalid = nothing rings.
NAQAH_CALL_ALLOWLIST=
# Public number shown as a tel: link in Settings. Keep the +country-code format.
NEXT_PUBLIC_NAQAH_PHONE_NUMBER=
# WhatsApp Cloud API. The owner recipient number is normally digits with country code.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
NAQAH_OWNER_WHATSAPP=
# Optional approved WhatsApp template for business-initiated messages outside the 24-hour service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Supabase owner login. Leave empty to keep the local demo; login then shows as unavailable.
# Setting both configures Auth; SMS/Google/email still need their providers/settings and authorized verification.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key. Required once CAPTCHA is on in Supabase, or no code can be sent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only: bypasses RLS for the voice service. Never prefix with NEXT_PUBLIC_. Use a secret
# key (sb_secret_...); the legacy service_role key is being retired. Not used by the demo.
SUPABASE_SECRET_KEY=
