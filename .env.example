# NAQAH environment. The browser demo needs none of these. Everything below is off when unset.
# [secret] = never commit a value, never prefix with NEXT_PUBLIC_. [paid] = turning it on can cost money.
# NEXT_PUBLIC_* values are inlined at build time: changing one needs a rebuild/redeploy.

# ── Site ─────────────────────────────────────────────────────────────────────────────────────────────
# Public origin for metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=
# Optional 40-character git SHA shown to signed-in owners by /api/integrations/status.
NEXT_PUBLIC_NAQAH_BUILD_COMMIT=

# ── Owner accounts (Supabase) ────────────────────────────────────────────────────────────────────────
# Exact build-time opt-in for both browser account mode and the server account gate. All other values disable it.
# Disabled: /api/account returns 404; owner Server Actions return unavailable before any session/repository access.
# Rollback needs a new build/deployment; it keeps saved data and does not stop voice or direct Supabase access.
NEXT_PUBLIC_NAQAH_ACCOUNT_DATA=
# Owner login. Leave empty to keep the demo; login then shows as unavailable. SMS/Google/email still need their
# providers configured in Supabase. Legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key. Required once CAPTCHA is on in Supabase, or no code can be sent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [secret] Server only: bypasses RLS for the voice service, schedulers and rate limits. Use a secret key
# (sb_secret_...). Legacy name SUPABASE_SERVICE_ROLE_KEY is still read as a fallback.
SUPABASE_SECRET_KEY=

# ── Phone line (Twilio) ──────────────────────────────────────────────────────────────────────────────
# Unset or "sample": the sample line, which saves nothing. "farm": real calls on real farms in Supabase; needs
# TWILIO_AUTH_TOKEN, NAQAH_PUBLIC_BASE_URL, SUPABASE_SECRET_KEY and the Supabase URL/key. See twilio-activation.md.
NAQAH_VOICE_MODE=
# [secret] HMAC key: signs the sample line's Gather state, call tokens on outbound URLs, and bridge requests.
# A random value of at least 32 bytes.
NAQAH_VOICE_SECRET=
# Public HTTPS origin Twilio calls back on; also used for webhook signatures behind proxies.
NAQAH_PUBLIC_BASE_URL=
# Answering-machine detection for report calls, optional (milliseconds; out-of-range values fall back to the default).
# Defaults suit long Arabic greetings: speech threshold 3500 (1000-6000), speech end 1000 (500-5000), silence timeout 5000 (2000-10000).
NAQAH_AMD_SPEECH_THRESHOLD_MS=
NAQAH_AMD_SPEECH_END_THRESHOLD_MS=
NAQAH_AMD_SILENCE_TIMEOUT_MS=
# [secret] Required for webhook signature checks. Production refuses unsigned voice requests without it.
TWILIO_AUTH_TOKEN=
# Outbound calls (report, instruction/verification and owner summary calls). Caller ID in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
# ar by default; en runs the voice flow in English. One locale per deployment.
NAQAH_VOICE_LOCALE=
# Optional Polly voices for scripted calls. Defaults: Polly.Zeina (Arabic) and Polly.Joanna (English).
NAQAH_VOICE_ARABIC_VOICE=
NAQAH_VOICE_ENGLISH_VOICE=
# Public number shown as a tel: link in Settings. Keep the +country-code format.
NEXT_PUBLIC_NAQAH_PHONE_NUMBER=

# ── Calls NAQAH places ───────────────────────────────────────────────────────────────────────────────
# Comma-separated Saudi mobiles (+9665XXXXXXXX) NAQAH may dial. Strict: unset, empty or invalid = nothing rings.
NAQAH_CALL_ALLOWLIST=
# Optional: lower the 300-second cap on every call NAQAH places (10–299). It can never raise it.
NAQAH_CALL_TIME_LIMIT_SECONDS=
# [paid] 1 = the owner's "Call now" on the dashboard (one report call to the farm's primary worker; 3/hour, 10/day).
NAQAH_MANUAL_REPORT_CALLS=
# [secret] Bearer secret for GET /api/cron/report-calls. Unset: the route refuses every request.
CRON_SECRET=
# [paid] 1 = the scheduler may dial report, worker instruction/verification and owner summary calls.
# Off by default, even with CRON_SECRET set. The trigger is pg_cron (20261113090000_report_call_scheduler.sql).
NAQAH_SCHEDULED_CALLS=
# [paid] 1 = owner summary calls: in farm mode the scheduler calls each farm's own owner number;
# on the sample line, the update call goes to NAQAH_OWNER_PHONE.
NAQAH_CALL_OWNER=

# ── Sample line only ─────────────────────────────────────────────────────────────────────────────────
# Registered caller IDs (E.164) for the sample line. Farm mode reads numbers from Supabase instead.
NAQAH_WORKER_PHONE=
NAQAH_OWNER_PHONE=
# [paid][secret] WhatsApp Cloud summary to one number. Sample line only; a real farm never uses it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
NAQAH_OWNER_WHATSAPP=
# Optional approved template for messages outside the 24-hour window. Language defaults to ar.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# ── Realtime voice (natural speech on report calls) ──────────────────────────────────────────────────
# Farm mode only. "realtime" hands report calls to the bridge; unset keeps the scripted call. See realtime-voice.md.
NAQAH_VOICE_ENGINE=
# The bridge's public URL: exactly wss://<host>/voice-bridge/media, no query string. Realtime stays off unless valid.
NAQAH_BRIDGE_PUBLIC_URL=
# [paid][secret] OpenAI key, for the bridge and the Voice Lab.
OPENAI_API_KEY=

# ── Voice bridge service (services/voice-bridge, runs outside Vercel) ────────────────────────────────
# Also needs NAQAH_BRIDGE_PUBLIC_URL, TWILIO_AUTH_TOKEN, NAQAH_VOICE_SECRET and OPENAI_API_KEY.
# Listen port (default 3300) and the Next.js origin it calls back (default http://127.0.0.1:3301).
PORT=
NAQAH_BRIDGE_UPSTREAM=
# Realtime voice: marin (default), cedar, alloy, ash, ballad, coral, echo, sage, shimmer or verse.
NAQAH_REALTIME_VOICE=
# DNS order for outbound lookups: ipv4first (default), ipv6first or verbatim. ipv4first avoids NAT64 timeouts.
NAQAH_BRIDGE_DNS_ORDER=
# Silence window, 5–60 seconds (default 12): after one quiet window the bridge reprompts, after a second it ends the call.
NAQAH_BRIDGE_SILENCE_SECONDS=
# Tests only: a loopback ws:// URL replacing the OpenAI Realtime endpoint.
NAQAH_REALTIME_URL=

# ── AI Voice Lab (/app/voice-lab, account mode) ──────────────────────────────────────────────────────
# [paid] 1 = the Lab API answers; otherwise 404. Needs OPENAI_API_KEY and NAQAH_VOICE_SECRET.
NAQAH_VOICE_LAB=
# User ids or confirmed emails allowed to open sessions, comma-separated.
NAQAH_VOICE_LAB_OWNERS=
# 1 = show the nav link. Hides the link only; the API decides access.
NEXT_PUBLIC_NAQAH_VOICE_LAB=

# ── Manual test calls (admin only) ───────────────────────────────────────────────────────────────────
# [paid] Exactly 1 enables /api/test-call. See docs/integrations/test-calls.md.
NAQAH_TEST_CALLS=
# User ids or confirmed emails, comma-separated.
NAQAH_TEST_CALL_ADMINS=
# 1 = show the nav link. Hides the link only.
NEXT_PUBLIC_NAQAH_TEST_CALL=

# ── Push notifications ───────────────────────────────────────────────────────────────────────────────
# Without these, notifications are shown locally while the app is open. npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [secret]
VAPID_PRIVATE_KEY=
# Contact for push services; defaults to mailto:hello@naqah.app.
VAPID_SUBJECT=

# ── Local demo runner only (scripts/test-call-local.mjs). Ignored on Vercel; never set in a deployment ───
# NAQAH_CALL_ALLOWLIST_FILE   approved numbers file in the OS temp directory (replaces NAQAH_CALL_ALLOWLIST)
# NAQAH_DEMO_REPEAT_FARMS     presentation ranch ids that may take another report call in the same period
# NAQAH_DEMO_NO_CALL_LIMIT    1 = the presentation ranch skips the call-now limit
# NAQAH_DEMO_OWNER_CALL       1 = the presentation ranch's owner can ask NAQAH to call now
# NAQAH_OWNER_APPROVES_TEST_NUMBERS  1 = the owner approves a test number in Settings
# NAQAH_VOICE_STYLE           natural = the natural-conversation report call
# NAQAH_CALL_TRACE_DIR        opt-in debug trace in a temp dir, loopback database only, deleted after 24 hours
# NEXT_PUBLIC_NAQAH_DEMO_AUTOFILL, NEXT_PUBLIC_NAQAH_DEMO_OWNER_CALL, NEXT_PUBLIC_NAQAH_NATURAL_CALLS,
# NEXT_PUBLIC_NAQAH_OWNER_APPROVES_NUMBERS   build-time UI switches set by the same runner
#
# Test suites only (not read by the app): NAQAH_TEST_DB, NAQAH_TEST_POSTGREST, NAQAH_TEST_GATEWAY,
# NAQAH_TEST_ANON_KEY, NAQAH_TEST_JWT_SECRET (local Postgres stack); NAQAH_REAL_MODEL=1 with NAQAH_REAL_MODEL_BUDGET,
# NAQAH_REAL_MODEL_LOG, NAQAH_REAL_MODEL_ONLY, NAQAH_REAL_MODEL_RUNS ([paid] live model tests).
# Removed: NAQAH_ALLOW_UNSIGNED_VOICE is no longer read by the app (only old tests stub it).
