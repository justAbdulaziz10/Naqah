# Server-side HMAC key for signing the stateless Gather conversation. Use a random value of at least 32 bytes.
NAQAH_VOICE_SECRET=
# Registered worker caller ID in E.164 format, for example +9665XXXXXXXX.
NAQAH_WORKER_PHONE=
# Registered owner caller ID in E.164 format. Owner inquiry calls are only matched when set.
NAQAH_OWNER_PHONE=
# Public HTTPS origin Twilio uses for webhook signatures when proxy headers do not preserve it.
NAQAH_PUBLIC_BASE_URL=
# Set to 1 only to allow unsigned voice calls in production; paid summaries stay disabled without verified signatures.
NAQAH_ALLOW_UNSIGNED_VOICE=
# ar by default; set to en to run the voice flow in English.
NAQAH_VOICE_LOCALE=
# Optional Polly voice overrides. Defaults: Polly.Zeina (Arabic) and Polly.Joanna (English).
NAQAH_VOICE_ARABIC_VOICE=
NAQAH_VOICE_ENGLISH_VOICE=
# Required for webhook signature checks. Production voice is disabled without it unless unsigned voice is explicitly allowed.
TWILIO_AUTH_TOKEN=
# Required only for outbound owner calls.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
# Set to 1 to place an outbound Twilio call with the saved report summary.
NAQAH_CALL_OWNER=
# Public number shown as a tel: link in Settings. Keep the +country-code format.
NEXT_PUBLIC_NAQAH_PHONE_NUMBER=
# WhatsApp Cloud API. The owner recipient number is normally digits with country code.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
NAQAH_OWNER_WHATSAPP=
# Optional approved WhatsApp template for business-initiated messages outside the 24-hour service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Supabase owner login. Leave empty to keep the local demo; login then shows as unavailable.
# Setting both enables real SMS sign-in, so read docs/integrations/owner-auth.md first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key. Required once CAPTCHA is on in Supabase, or no code can be sent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only: bypasses RLS for the voice service. Never prefix with NEXT_PUBLIC_. Use a secret
# key (sb_secret_...); the legacy service_role key is being retired. Not used by the demo.
SUPABASE_SECRET_KEY=
