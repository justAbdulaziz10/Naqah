# Operator workstation only; load from a protected local file, never put values on argv.
# Set these names for a tick:
# PREVIEW_ORIGIN
# CRON_SECRET
# VERCEL_AUTOMATION_BYPASS_SECRET (when Deployment Protection is enabled)
# NAQAH_TEST_RANCH_ID
# NAQAH_TEST_CALL_PHASE
# Optional evidence location: NAQAH_EVIDENCE_DIR (default <repo>/.realcall/evidence)

# Set these additional names for free preflight probes:
# TWILIO_AUTH_TOKEN
# NAQAH_VOICE_SECRET
# NAQAH_VOICE_MODE
# NAQAH_VOICE_LOCALE
# NAQAH_CALL_ALLOWLIST

# Must stay absent unless the current runbook phase explicitly enables them:
# NAQAH_SCHEDULED_CALLS
# NAQAH_CALL_OWNER
# NAQAH_MANUAL_REPORT_CALLS (remove before scheduled phases)
# OPENAI_API_KEY (bridge only)
# SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY
