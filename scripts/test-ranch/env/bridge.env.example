# Voice bridge only; keep all Supabase and cron credentials out of this process.
# Set these names:
# OPENAI_API_KEY
# TWILIO_AUTH_TOKEN
# NAQAH_VOICE_SECRET
# NAQAH_BRIDGE_PUBLIC_URL
# NAQAH_BRIDGE_UPSTREAM
# NAQAH_BRIDGE_UPSTREAM must point to the guarded proxy at 127.0.0.1:55555.
# PORT

# These names must be unset on the bridge:
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY
# CRON_SECRET
# NAQAH_CALL_TRACE_DIR
# NAQAH_CALL_TIME_LIMIT_SECONDS (leave unset on both Vercel and the bridge)
# NAQAH_REALTIME_URL (leave unset for the real provider; local mock rehearsal overrides it)
